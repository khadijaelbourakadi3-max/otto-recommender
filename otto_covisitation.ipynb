TYPES = ["clicks", "carts", "orders"]

# 80 % pour construire le modèle, 20 % pour valider
n = len(train)
fit_sessions, val_sessions = train[: int(n * 0.8)], train[int(n * 0.8):]

# Popularité calculée uniquement sur fit_sessions (pas de fuite)
pop_fit = Counter(e["aid"] for s in fit_sessions for e in s["events"])
top20 = [aid for aid, _ in pop_fit.most_common(20)]

def split_session(events):
    cut = max(1, len(events) // 2)
    return events[:cut], events[cut:]

def evaluate(val_sessions, predict_fn):
    hits = dict.fromkeys(TYPES, 0)
    denom = dict.fromkeys(TYPES, 0)
    for s in val_sessions:
        hist, future = split_session(s["events"])
        if not future:
            continue
        pred = predict_fn(hist)
        for t in TYPES:
            truth = [e["aid"] for e in future if e["type"] == t]
            if t == "clicks":
                truth = truth[:1]
            truth = set(truth)
            hits[t] += len(set(pred[t][:20]) & truth)
            denom[t] += min(20, len(truth))
    R = {t: hits[t] / denom[t] for t in TYPES if denom[t]}
    score = 0.1 * R["clicks"] + 0.3 * R["carts"] + 0.6 * R["orders"]
    return R, score

# Baseline 1 : popularité
def predict_pop(history):
    return {t: top20 for t in TYPES}

# Baseline 2 : derniers produits vus
def predict_last(history):
    seen = list(dict.fromkeys(e["aid"] for e in reversed(history)))
    lst = (seen + [a for a in top20 if a not in seen])[:20]
    return {t: lst for t in TYPES}

for name, fn in [("Popularité", predict_pop), ("Derniers vus", predict_last)]:
    R, score = evaluate(val_sessions, fn)
    print(name, {t: round(v, 4) for t, v in R.items()}, "Score :", round(score, 4))


from collections import defaultdict

TYPE_W = {"clicks": 1.0, "carts": 3.0, "orders": 6.0}

def build_covisit(sessions, max_events=30, window=10, top_k=50):
    covisit = defaultdict(Counter)
    buy = defaultdict(Counter)
    for s in sessions:
        ev = s["events"][-max_events:]
        for i, a in enumerate(ev):
            for j in range(i + 1, min(i + 1 + window, len(ev))):
                b = ev[j]
                if a["aid"] == b["aid"]:
                    continue
                w = 1.0 / (j - i)
                covisit[a["aid"]][b["aid"]] += w
                covisit[b["aid"]][a["aid"]] += w
                if a["type"] != "clicks" or b["type"] != "clicks":
                    buy[a["aid"]][b["aid"]] += w
                    buy[b["aid"]][a["aid"]] += w
    prune = lambda m: {k: v.most_common(top_k) for k, v in m.items()}
    return prune(covisit), prune(buy)

def rank(history, matrix, own_bonus, type_bonus):
    scores = Counter()
    recent = list(reversed(history[-20:]))
    for r, e in enumerate(recent):
        rec = 1.0 / (1 + r)
        w = TYPE_W[e["type"]] * rec
        scores[e["aid"]] += own_bonus * w + type_bonus.get(e["type"], 0) * rec
        neighbors = matrix.get(e["aid"], [])
        if neighbors:
            mx = neighbors[0][1]
            for nb, c in neighbors:
                scores[nb] += w * c / mx
    return scores

def complete(scores):
    ranked = [a for a, _ in scores.most_common(40)]
    return (ranked + [a for a in top20 if a not in ranked])[:20]

def predict_cov(history, covisit, buy):
    return {
        "clicks": complete(rank(history, covisit, 1.0, {})),
        "carts":  complete(rank(history, covisit, 1.0, {"carts": 5.0})),
        "orders": complete(rank(history, buy, 1.0, {"carts": 10.0, "orders": 3.0})),
    }

# Matrices construites uniquement sur fit_sessions (pas de fuite)
covisit, buy = build_covisit(fit_sessions)

R, score = evaluate(val_sessions, lambda h: predict_cov(h, covisit, buy))
print("Co-visitation", {t: round(v, 4) for t, v in R.items()}, "Score :", round(score, 4))


def own_ranking(history, prio, decay=True):
    """Classe les produits de la session. prio : poids par type d'événement."""
    sc = {}
    for r, e in enumerate(reversed(history)):
        w = prio[e["type"]] / ((1 + r) if decay else 1)
        sc[e["aid"]] = sc.get(e["aid"], 0) + w
    return sorted(sc, key=sc.get, reverse=True)

def neighbor_ranking(history, matrix, exclude, last_n=5):
    sc = Counter()
    for r, e in enumerate(reversed(history[-last_n:])):
        nb = matrix.get(e["aid"], [])
        if not nb:
            continue
        mx = nb[0][1]
        for a, c in nb:
            if a not in exclude:
                sc[a] += (c / mx) / (1 + r)
    return [a for a, _ in sc.most_common(40)]

def build_list(own, neigh):
    lst = own + [a for a in neigh if a not in own]
    return (lst + [a for a in top20 if a not in lst])[:20]

def predict_cov2(history, covisit, buy, n_own=20):
    own_click = own_ranking(history, {"clicks": 1, "carts": 1, "orders": 1})
    own_cart  = own_ranking(history, {"clicks": 1, "carts": 4, "orders": 4})
    own_order = own_ranking(history, {"clicks": 1, "carts": 8, "orders": 8})
    out = {}
    for t, own, mat in [("clicks", own_click, covisit),
                        ("carts", own_cart, covisit),
                        ("orders", own_order, buy)]:
        own = own[:n_own]
        out[t] = build_list(own, neighbor_ranking(history, mat, set(own)))
    return out

for n_own in [20, 15, 10]:
    R, score = evaluate(val_sessions, lambda h: predict_cov2(h, covisit, buy, n_own))
    print("n_own =", n_own, {t: round(v, 4) for t, v in R.items()}, "Score :", round(score, 4))


