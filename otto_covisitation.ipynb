# Essai C : plus de voisins regardés
def neighbor_ranking(history, matrix, exclude, last_n=10):
    sc = Counter()
    for r, e in enumerate(reversed(history[-last_n:])):
        nb = matrix.get(e["aid"], [])
        if not nb:
            continue
        mx = nb[0][1]
        for a, c in nb:
            if a not in exclude:
                sc[a] += (c / mx) / (1 + r)
    return [a for a, _ in sc.most_common(40)]
R, score = evaluate(val_sessions, lambda h: predict_cov2(h, covisit, buy, 20))
print("last_n=10", {t: round(v, 4) for t, v in R.items()}, "Score :", round(score, 4))


import csv

# Matrices sur tout l'échantillon, popularité recalculée sur tout l'échantillon
covisit_full, buy_full = build_covisit(train)
pop_full = Counter(e["aid"] for s in train for e in s["events"])
top20 = [aid for aid, _ in pop_full.most_common(20)]

with open(TEST_PATH) as f, open("/kaggle/working/submission.csv", "w", newline="") as out:
    w = csv.writer(out)
    w.writerow(["session_type", "labels"])
    for line in f:
        s = json.loads(line)
        preds = predict_cov2(s["events"], covisit_full, buy_full, 20)
        for t in TYPES:
            w.writerow([f"{s['session']}_{t}", " ".join(map(str, preds[t]))])

