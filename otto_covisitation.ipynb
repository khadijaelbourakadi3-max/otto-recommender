import json
from collections import Counter

PATH = "/kaggle/input/competitions/otto-recommender-system/train.jsonl"
TEST_PATH = "/kaggle/input/competitions/otto-recommender-system/test.jsonl"

def read_sessions(path, max_sessions=50_000):
    sessions = []
    with open(path) as f:
        for i, line in enumerate(f):
            if i >= max_sessions:
                break
            sessions.append(json.loads(line))
    return sessions

